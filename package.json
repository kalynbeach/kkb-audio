{
  "name": "kkb-audio-worklet-proof",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun run build:worklet && bun tools/serve-lab.ts",
    "build:worklet": "bun tools/build-worklet.ts",
    "test": "bun test web/test",
    "typecheck": "bun x tsc --noEmit",
    "check:wasm": "bun tools/check-wasm-memory.ts web/dist/kkb_audio_bg.wasm",
    "check:wav": "bun test tools/check-local-wav.test.ts tools/check-sample-rate.test.ts tools/check-local-pcm-scheduling.test.ts tools/check-wav-seek.test.ts",
    "check:kernel": "bun tools/check-worklet-kernel.ts",
    "check:plan": "bun tools/check-worklet-plan.ts",
    "audit:plan": "bun tools/audit-plan-worklet.ts web/dist/plan-processor.js",
    "audit:worklet": "bun tools/audit-worklet.ts web/dist/worklet-processor.js",
    "check:lab": "bun test tools/check-lab.test.ts tools/check-lab-canvas.test.ts",
    "check:lab-ui": "bun test tools/check-lab-ui.test.tsx",
    "check": "bun run build:worklet && bun run typecheck && bun test web/test && bun run check:wasm && bun run check:kernel && bun run check:wav && bun run check:plan && bun run check:lab && bun run check:lab-ui && bun run audit:worklet && bun run audit:plan",
    "serve:proof": "bun tools/serve-proof.ts"
  },
  "imports": {
    "#components/*": "./web/src/components/*.tsx",
    "#lib/*": "./web/src/lib/*.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/bun": "1.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "bun": "1.4.0",
    "bun-plugin-tailwind": "0.1.2",
    "inter-ui": "4.1.1",
    "shadcn": "4.19.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  }
}
