{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2024",
    "types": ["bun"]
  },
  "include": [
    "tools/**/*.ts",
    "tools/**/*.tsx",
    "web/src/**/*.ts",
    "web/src/**/*.tsx",
    "web/test/**/*.ts",
    "web/test/**/*.tsx"
  ]
}
