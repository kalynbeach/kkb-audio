  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "target": "ES2024",
    "types": ["bun"]
  },
  "include": ["tools/**/*.ts", "web/src/**/*.ts", "web/test/**/*.ts"]
}
